# They are large (~155MB) and must be downloaded manually — see vault/themes/fonts/README.md.
# Only the README lives in git; everything else inside that folder is ignored.
vault/themes/fonts/*
!vault/themes/fonts/README.md

lib

# claude
.claude/*
tmpclaude-*
